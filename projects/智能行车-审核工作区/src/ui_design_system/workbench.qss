
            QMainWindow, QWidget#root { background: #f3f6fb; }
            QWidget { color: #172033; font-size: 14px; }

            QFrame#heroCard {
                background: #12325b;
                border: 1px solid #1d4677;
                border-radius: 16px;
            }
            QLabel#brandLabel {
                color: #d7e9ff;
                background: #244d7b;
                border: 1px solid #3b6592;
                border-radius: 10px;
                padding: 4px 8px;
                font-size: 12px;
                font-weight: 700;
            }
            QLabel#pageTitle { color: white; font-size: 25px; font-weight: 700; }
            QLabel#subtitle { color: #c8d8eb; font-size: 13px; }
            QLabel#versionBadge {
                color: #d7e9ff;
                background: #1b416d;
                border: 1px solid #37628f;
                border-radius: 16px;
                font-size: 12px;
                font-weight: 600;
            }
            QPushButton#settingsButton {
                color: #e5f0ff;
                background: transparent;
                border: 1px solid #4b7099;
                border-radius: 8px;
                padding: 0;
                font-size: 12px;
                font-weight: 600;
            }
            QPushButton#settingsButton:hover {
                color: white;
                background: #244d7b;
                border-color: #6f94bd;
            }

            QFrame#panelCard, QFrame#resultCard {
                background: white;
                border: 1px solid #dce4ef;
                border-radius: 14px;
            }
            QFrame#resultCard { border-color: #cfdced; }
            QLabel#stepBadge {
                color: white;
                background: #246fdb;
                border-radius: 15px;
                font-weight: 700;
            }
            QLabel#sectionTitle, QLabel#listTitle {
                color: #172033;
                font-size: 15px;
                font-weight: 700;
            }
            QLabel#sectionHint { color: #778397; font-size: 12px; }
            QLabel#countBadge {
                color: #315b91;
                background: #eaf2ff;
                border-radius: 10px;
                padding: 3px 9px;
                font-size: 12px;
                font-weight: 600;
            }

            QFrame#dropArea {
                background: #f7faff;
                border: 2px dashed #9bb8df;
                border-radius: 11px;
                min-height: 126px;
            }
            QFrame#dropArea[dragActive="true"] {
                background: #eaf3ff;
                border-color: #246fdb;
            }
            QFrame#dropArea:focus {
                background: #f1f7ff;
                border-color: #246fdb;
            }
            QFrame#dropArea:disabled {
                background: #f4f5f7;
                border-color: #cfd5dd;
            }
            QLabel#dropIcon {
                color: white;
                background: #246fdb;
                border-radius: 17px;
                min-width: 34px;
                min-height: 34px;
                max-width: 34px;
                max-height: 34px;
                font-size: 20px;
                font-weight: 700;
            }
            QLabel#dropTitle { color: #213650; font-size: 17px; font-weight: 700; }
            QLabel#dropHint { color: #66758a; font-size: 12px; }

            QComboBox {
                min-height: 40px;
                padding: 0 12px;
                background: #f9fbfe;
                border: 1px solid #cfd9e7;
                border-radius: 8px;
                selection-background-color: #246fdb;
            }
            QComboBox:hover { border-color: #7da5d8; background: white; }
            QComboBox:focus { border: 1px solid #246fdb; background: white; }
            QComboBox::drop-down { width: 34px; border: none; }

            QPushButton {
                min-height: 38px;
                padding: 0 16px;
                border: 1px solid #c9d3e0;
                border-radius: 8px;
                background: white;
                color: #26364b;
                font-weight: 600;
            }
            QPushButton:hover { background: #f2f6fb; border-color: #9eb2ca; }
            QPushButton:pressed { background: #e8eef6; }
            QPushButton:disabled {
                color: #9ca7b5;
                background: #f2f4f7;
                border-color: #e1e5ea;
            }
            QPushButton#primaryButton {
                min-width: 156px;
                background: #246fdb;
                color: white;
                border: 1px solid #246fdb;
            }
            QPushButton#primaryButton:hover { background: #1c5fbe; border-color: #1c5fbe; }
            QPushButton#primaryButton:pressed { background: #174f9e; }
            QPushButton#primaryButton:disabled {
                color: #f1f4f8;
                background: #aebdce;
                border-color: #aebdce;
            }
            QPushButton#secondaryButton { color: #1e5fae; border-color: #9ebce2; }
            QPushButton#ghostButton { color: #66758a; background: transparent; border-color: transparent; }
            QPushButton#ghostButton:hover { color: #2c4667; background: #eef3f8; }

            QListWidget {
                background: #f8fafc;
                border: 1px solid #dbe3ed;
                border-radius: 9px;
                padding: 5px;
                outline: none;
            }
            QListWidget::item {
                color: #23364e;
                background: white;
                border: 1px solid #e1e7ef;
                border-radius: 7px;
                padding: 8px 10px;
            }
            QListWidget::item:selected { color: #174f9e; background: #eaf2ff; border-color: #8bb2e7; }
            QListWidget::item:hover:!selected { background: #f4f8fd; border-color: #c4d5e8; }

            QProgressBar {
                min-height: 18px;
                border: none;
                border-radius: 9px;
                background: #e8edf4;
                text-align: center;
                color: #39506d;
                font-size: 11px;
                font-weight: 600;
            }
            QProgressBar::chunk { background: #2a7de1; border-radius: 9px; }
            QLabel#outputLocation {
                color: #315b91;
                background: #eaf2ff;
                border-radius: 7px;
                padding: 7px 10px;
                font-size: 12px;
            }
            QLabel#statusLabel {
                color: #5d6c80;
                background: #f7f9fc;
                border-radius: 7px;
                padding: 8px 10px;
            }
            QLabel#statusLabel[state="success"] { color: #17663b; background: #eaf7ef; }
            QLabel#statusLabel[state="busy"] { color: #1d5eaa; background: #eaf3ff; }

QLineEdit, QDoubleSpinBox { min-height: 34px; padding: 0 10px; background: #f9fbfe; border: 1px solid #cfd9e7; border-radius: 8px; }
QLineEdit:focus, QDoubleSpinBox:focus { border-color: #246fdb; background: white; }
QScrollArea { border: none; background: white; }
QWidget#formHost { background: white; }
QDialog { background: #f3f6fb; }
QLabel#statusLabel[state="error"] { color: #9d2530; background: #fff0f1; }
